# ChristineAI environment configuration
# Copy this file to .env and fill in your real values.

# Core service hostnames
CHRISTINE_WERNICKE_SERVER=your-wernicke-server.lan
CHRISTINE_BROCA_SERVER=your-broca-server.lan
CHRISTINE_NEOCORTEX_SERVER=your-neocortex-server.lan

# Character configuration
CHRISTINE_USER_NAME=Phantom
CHRISTINE_CHAR_NAME=Christine

# Wernicke configuration
CHRISTINE_WERNICKE_PV_KEY=
CHRISTINE_WERNICKE_VAD=webrtcvad

# LLM configuration
CHRISTINE_ENABLED_LLMS=openrouter
CHRISTINE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
CHRISTINE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
CHRISTINE_OPENROUTER_SITE_URL=
CHRISTINE_OPENROUTER_SITE_NAME=ChristineAI

# Prompt caching. Christine's stable context block (identity, self-definition, tools,
# yesterday, earlier today) gets a cache breakpoint so it's billed at the cheap
# cache-read rate instead of full price on every turn. Sensor readings are sent after
# the breakpoint so they don't invalidate it.
# TTL: '1h' costs more to write but survives gaps between conversations; '5m' is the
# cheaper short window. Leave empty for the provider default.
CHRISTINE_OPENROUTER_CACHE_ENABLED=true
CHRISTINE_OPENROUTER_CACHE_TTL=1h

# STT configuration (comma-separated for failover order)
CHRISTINE_ENABLED_STTS=whisper,openrouter
CHRISTINE_OPENROUTER_STT_URL=https://openrouter.ai/api/v1/audio/transcriptions
CHRISTINE_OPENROUTER_STT_MODEL=mistralai/voxtral-mini-transcribe
CHRISTINE_OPENROUTER_STT_LANGUAGE=en
CHRISTINE_OPENROUTER_STT_TIMEOUT_SECONDS=60

# Optional API keys
# CHRISTINE_OPENAI_API_KEY=your-openai-api-key
# CHRISTINE_GEMINI_API_KEY=your-gemini-api-key

# Optional service toggles
# CHRISTINE_ENABLED_TTSS=broca_server
# CHRISTINE_AUDIO_OUTPUT_MODE=local
# CHRISTINE_BROCA_TTS_CONCURRENCY=2

# Forehead camera. Her eye. Replaces the photoresistors the older body had in
# its eye sockets, and is the input for object/face detection and vision LLMs.
# CHRISTINE_CAMERA_ENABLED=true
# CHRISTINE_CAMERA_DEVICE=/dev/video0
# Sensor gain held fixed during light metering. Changing it changes calibration.
# CHRISTINE_CAMERA_GAIN=32
# Deadlock guard, not a latency target. Long exposures in a dark room are slow.
# CHRISTINE_CAMERA_CAPTURE_TIMEOUT_SECONDS=30
# How often she takes a light reading. Each costs ~2s of one core, and this Pi
# is also doing realtime audio, so slow is deliberate.
# CHRISTINE_LIGHT_POLL_SECONDS=20
# Calibration: log10 luminance mapped to light level 0% and 100%. Measured on
# the real camera, a normally lit bedroom reads about -1.7. Also adjustable live
# from the web UI.
# CHRISTINE_LIGHT_LOG_MIN=-4.0
# CHRISTINE_LIGHT_LOG_MAX=-0.3
# Snapshots for detection / vision LLM work.
# CHRISTINE_CAMERA_SNAPSHOT_SIZE=640x480
# CHRISTINE_CAMERA_SNAPSHOT_DIR=/root/ChristineAI/logs/snapshots
# CHRISTINE_CAMERA_SNAPSHOT_WARMUP_FRAMES=12
